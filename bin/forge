#!/usr/bin/env sh
set -eu

usage() {
  cat <<'EOF'
Usage:
  forge [--forge oracle|work] repos [OWNER]
  forge [--forge oracle|work] list-open [REPO]
  forge [--forge oracle|work] state ISSUE
  forge [--forge oracle|work] comment ISSUE BODY
  forge [--forge oracle|work] comment ISSUE --body-file PATH|-
  forge [--forge oracle|work] label-add ISSUE LABEL
  forge [--forge oracle|work] label-remove ISSUE LABEL
  forge [--forge oracle|work] label-set ISSUE LABEL
  forge [--forge oracle|work] issue-create [REPO] TITLE BODY               [OPTIONS]
  forge [--forge oracle|work] issue-create [REPO] TITLE --body-file PATH   [OPTIONS]
  forge [--forge oracle|work] issue-create [REPO] TITLE --body-file -      [OPTIONS]   # stdin
  forge [--forge oracle|work] auto-fix-template ISSUE

OPTIONS (comment):
  --body-file PATH|-                                      # multi-line body from file/stdin

OPTIONS (issue-create):
  --labels L1,L2,...
  --mm-channel CHID --mm-root-id RID [--mm-account ID]   # Mattermost thread bridge
                                                         # both channel and root required when used
                                                         # account defaults to "forgebot"

ISSUE forms:
  N                  → current profile's default repo (e.g. "1")
  owner/repo#N       → explicit (e.g. "glg-bot/sandbox#1")
REPO forms (for list-open / issue-create):
  owner/repo         → explicit
  repo               → "<FORGE_USER>/repo"
  (omitted)          → default repo per profile
OWNER form (for repos):
  (omitted)          → "<FORGE_USER>" (current profile's bot user, usually "glg-bot")
  username           → explicit (e.g. "glg-bot")

Profile selection (priority):
  1. --forge <profile> flag
  2. FORGE_PROFILE env var
  3. cwd pattern:  */repos/work/*  → work
                   */repos/gh/*    → oracle
                   (else)          → error: ambiguous cwd, must pass --forge/FORGE_PROFILE

Legacy env value fallback (URL/TOKEN only):
  If a profile's prefixed env is missing, unprefixed FORGE_URL/FORGE_TOKEN
  is consulted last — this is the host-scoped switching path from ~/.env.local
  (only relevant when ssh'd directly into oracle or work).
  FORGE_REPO has NO unprefixed fallback (leak-prevention).

Profile-prefixed env (~/.env.local SSOT):
  ORACLE_FORGE_URL,   ORACLE_FORGE_TOKEN,   ORACLE_FORGE_USER,   [ORACLE_FORGE_REPO]
  WORK_FORGE_URL,  WORK_FORGE_TOKEN,  WORK_FORGE_USER,  [WORK_FORGE_REPO]

Defaults:
  FORGE_REPO          oracle: glg-bot/sandbox.  work: must be set or passed.
  FORGE_BOT_FOOTER    — glg-bot [<FORGE_MODEL or "unknown"> / <~/.current-device>]
EOF
}

resolve_profile() {
  # 1. already set explicitly (--forge or env) → use as-is
  if [ -n "${FORGE_PROFILE:-}" ]; then
    return
  fi
  # 2. cwd pattern — only explicit anchors. Neutral cwd ($HOME, ~/org, ~/Downloads…)
  #    is treated as ambiguous and refuses to default, so a mutating command never
  #    auto-targets the wrong instance.
  case "$PWD/" in
    */repos/work/*) FORGE_PROFILE="work" ;;
    */repos/gh/*)   FORGE_PROFILE="oracle"  ;;
    *)
      echo "ERROR: cwd ($PWD) is neither under repos/work/* nor repos/gh/*." >&2
      echo "       Pass --forge oracle|work or set FORGE_PROFILE." >&2
      exit 2 ;;
  esac
}

apply_profile() {
  # NOTE: FORGE_REPO is set from profile-specific sources only.
  # Unprefixed FORGE_REPO from the parent shell is intentionally ignored to prevent
  # leaks across profiles (e.g. oracle's `glg-bot/sandbox` accidentally targeting
  # a same-named repo on work).
  case "$FORGE_PROFILE" in
    oracle)
      FORGE_URL="${ORACLE_FORGE_URL:-${FORGE_URL:-}}"
      FORGE_TOKEN="${ORACLE_FORGE_TOKEN:-${FORGE_TOKEN:-}}"
      FORGE_USER="${ORACLE_FORGE_USER:-${FORGE_USER:-glg-bot}}"
      FORGE_REPO="${ORACLE_FORGE_REPO:-glg-bot/sandbox}"
      ;;
    work)
      FORGE_URL="${WORK_FORGE_URL:-${FORGE_URL:-}}"
      FORGE_TOKEN="${WORK_FORGE_TOKEN:-${FORGE_TOKEN:-}}"
      FORGE_USER="${WORK_FORGE_USER:-${FORGE_USER:-glg-bot}}"
      FORGE_REPO="${WORK_FORGE_REPO:-}"
      ;;
    *)
      echo "ERROR: unknown FORGE_PROFILE='$FORGE_PROFILE' (expected: oracle|work)" >&2
      exit 2
      ;;
  esac
}

# stderr observability for mutating commands — the operator should always see
# which (profile, repo, url) a write is going against before it lands.
# Caller passes the resolved target repo so this reflects the actual write
# destination, not DEFAULT_REPO (which is empty for work profile, and only
# accidentally correct for oracle when explicit repo args coincide with the
# default).
log_context() {
  echo "[forge] profile=$FORGE_PROFILE repo=$1 url=$FORGE_URL" >&2
}

build_default_footer() {
  host_short=$(cat "$HOME/.current-device" 2>/dev/null || echo unknown)
  model_short="${FORGE_MODEL:-unknown}"
  # First format-arg never starts with '-' (em-dash is U+2014), so `--` is unnecessary
  # and unsafe under strict POSIX printf.
  printf '%s glg-bot [%s / %s]' "—" "$model_short" "$host_short"
}

require_env() {
  resolve_profile
  apply_profile
  : "${FORGE_URL:?FORGE_URL is required (profile=$FORGE_PROFILE — set ${FORGE_PROFILE}_FORGE_URL in ~/.env.local)}"
  : "${FORGE_TOKEN:?FORGE_TOKEN is required (profile=$FORGE_PROFILE)}"
  : "${FORGE_USER:=glg-bot}"
  # Always rebuild footer from FORGE_MODEL + ~/.current-device.
  # Any inherited FORGE_BOT_FOOTER from parent shells is intentionally ignored —
  # footer format is policy, only the model slot is per-session.
  FORGE_BOT_FOOTER=$(build_default_footer)
  DEFAULT_REPO="$FORGE_REPO"
  API="${FORGE_URL%/}/api/v1"
}

api() {
  method="$1"; path="$2"; data="${3-}"
  if [ -n "$data" ]; then
    curl -fsS -X "$method" \
      -H "Authorization: token $FORGE_TOKEN" \
      -H "Content-Type: application/json" \
      --data "$data" \
      "$API$path"
  else
    curl -fsS -X "$method" \
      -H "Authorization: token $FORGE_TOKEN" \
      "$API$path"
  fi
}

repo_path() {
  repo="$1"
  case "$repo" in
    */*) printf '%s' "$repo" ;;
    *) printf '%s/%s' "$FORGE_USER" "$repo" ;;
  esac
}

issue_number() {
  case "$1" in
    *#*) printf '%s' "${1##*#}" ;;
    *) printf '%s' "$1" ;;
  esac
}

issue_repo() {
  case "$1" in
    *#*) printf '%s' "${1%#*}" ;;
    *) printf '%s' "$DEFAULT_REPO" ;;
  esac
}

cmd_list_open() {
  repo="$(repo_path "${1:-$DEFAULT_REPO}")"
  api GET "/repos/$repo/issues?state=open" | jq -r '
    if length == 0 then "(no open issues)"
    else .[] | "#\(.number) [\(.state)] \(.title) labels=[\([.labels[].name] | join(","))] comments=\(.comments)"
    end'
}

cmd_repos() {
  owner="${1:-$FORGE_USER}"
  api GET "/users/$owner/repos?limit=50" | jq -r '
    if length == 0 then "(no repos under " + "'"$owner"'" + ")"
    else sort_by(.full_name) | .[] | "\(.full_name) (\(.open_issues_count) open) — \(.description // "")"
    end'
}

cmd_comment() {
  [ "$#" -ge 2 ] || { usage >&2; exit 2; }
  issue="$1"; shift

  case "${1:-}" in
    --body-file)
      [ "$#" -eq 2 ] || { echo "comment --body-file needs exactly PATH (or '-')" >&2; exit 2; }
      body_file="$2"
      if [ "$body_file" = "-" ]; then
        body=$(cat)
      else
        [ -r "$body_file" ] || { echo "ERROR: --body-file not readable: $body_file" >&2; exit 2; }
        body=$(cat -- "$body_file")
      fi
      ;;
    --body-file=*)
      [ "$#" -eq 1 ] || { echo "comment --body-file=PATH cannot be combined with inline BODY args" >&2; exit 2; }
      body_file="${1#--body-file=}"
      if [ "$body_file" = "-" ]; then
        body=$(cat)
      else
        [ -r "$body_file" ] || { echo "ERROR: --body-file not readable: $body_file" >&2; exit 2; }
        body=$(cat -- "$body_file")
      fi
      ;;
    --*)
      echo "unknown comment option: $1" >&2; usage >&2; exit 2 ;;
    *)
      body="$*" ;;
  esac

  [ -n "$body" ] || { echo "ERROR: empty comment body" >&2; exit 2; }
  repo="$(repo_path "$(issue_repo "$issue")")"
  num="$(issue_number "$issue")"
  log_context "$repo"
  full_body=$(printf '%s\n\n%s' "$body" "$FORGE_BOT_FOOTER")
  payload=$(jq -n --arg body "$full_body" '{body:$body}')
  api POST "/repos/$repo/issues/$num/comments" "$payload" | jq -r '"comment #\(.id) by \(.user.login): \(.body | split("\n")[0])"'
}

label_id_by_name() {
  _repo="$1"; _label="$2"
  api GET "/repos/$_repo/labels" | jq -r --arg name "$_label" '.[] | select(.name == $name) | .id' | head -n1
}

cmd_label_add() {
  [ "$#" -eq 2 ] || { usage >&2; exit 2; }
  issue="$1"; label="$2"
  repo="$(repo_path "$(issue_repo "$issue")")"
  num="$(issue_number "$issue")"
  log_context "$repo"
  label_id=$(label_id_by_name "$repo" "$label")
  [ -n "$label_id" ] || { echo "label not found: $label" >&2; exit 1; }
  payload=$(jq -n --argjson id "$label_id" '{labels:[$id]}')
  api POST "/repos/$repo/issues/$num/labels" "$payload" | jq -r '"labels=[\([.[].name] | join(","))]"'
}

cmd_label_remove() {
  [ "$#" -eq 2 ] || { usage >&2; exit 2; }
  issue="$1"; label="$2"
  repo="$(repo_path "$(issue_repo "$issue")")"
  num="$(issue_number "$issue")"
  log_context "$repo"
  label_id=$(label_id_by_name "$repo" "$label")
  [ -n "$label_id" ] || { echo "label not found: $label" >&2; exit 1; }
  api DELETE "/repos/$repo/issues/$num/labels/$label_id" >/dev/null
  api GET "/repos/$repo/issues/$num" | jq -r '"labels=[\([.labels[].name] | join(","))]"'
}

cmd_label_set() {
  [ "$#" -eq 2 ] || { usage >&2; exit 2; }
  issue="$1"; label="$2"
  repo="$(repo_path "$(issue_repo "$issue")")"
  num="$(issue_number "$issue")"

  case "$label" in
    agent:ready|agent:running|agent:done|agent:blocked|human:needs-review) ;;
    *) echo "ERROR: label-set only accepts status labels: agent:ready, agent:running, agent:done, agent:blocked, human:needs-review" >&2; exit 2 ;;
  esac

  log_context "$repo"
  labels_json=$(api GET "/repos/$repo/labels")
  target_id=$(printf '%s' "$labels_json" | jq -r --arg name "$label" '.[] | select(.name == $name) | .id' | head -n1)
  [ -n "$target_id" ] || { echo "label not found: $label (create it first in this repo)" >&2; exit 1; }

  issue_json=$(api GET "/repos/$repo/issues/$num")
  label_ids_json=$(printf '%s' "$issue_json" | jq --argjson target "$target_id" '
    [ .labels[]
      | select(.name != "agent:ready"
          and .name != "agent:running"
          and .name != "agent:done"
          and .name != "agent:blocked"
          and .name != "human:needs-review")
      | .id
    ] + [$target]
    | unique
  ')
  payload=$(jq -n --argjson labels "$label_ids_json" '{labels:$labels}')
  api PUT "/repos/$repo/issues/$num/labels" "$payload" | jq -r '"labels=[\([.[].name] | join(","))]"'
}

cmd_issue_create() {
  # Forms:
  #   issue-create REPO TITLE BODY                 [OPTIONS]
  #   issue-create TITLE BODY                      [OPTIONS]   (uses DEFAULT_REPO)
  #   issue-create REPO TITLE --body-file PATH     [OPTIONS]
  #   issue-create TITLE --body-file PATH          [OPTIONS]
  # --body-file -  reads BODY from stdin.
  # First positional is REPO iff it contains '/'. Otherwise it's TITLE.
  # NOTE: TITLE stays single-line. Multi-line content belongs in BODY via --body-file.
  labels_csv=""
  body_file=""
  mm_channel=""
  mm_root_id=""
  mm_account=""
  positional=""
  NL=$(printf '\nx'); NL="${NL%x}"  # POSIX-safe newline literal

  # Strip flags from args; keep the rest positional in order.
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --labels)
        [ "$#" -ge 2 ] || { echo "--labels needs a value (comma-separated)" >&2; exit 2; }
        labels_csv="$2"; shift 2 ;;
      --labels=*)
        labels_csv="${1#--labels=}"; shift ;;
      --body-file)
        [ "$#" -ge 2 ] || { echo "--body-file needs PATH (or '-' for stdin)" >&2; exit 2; }
        body_file="$2"; shift 2 ;;
      --body-file=*)
        body_file="${1#--body-file=}"; shift ;;
      --mm-channel)
        [ "$#" -ge 2 ] || { echo "--mm-channel needs a value" >&2; exit 2; }
        mm_channel="$2"; shift 2 ;;
      --mm-channel=*)
        mm_channel="${1#--mm-channel=}"; shift ;;
      --mm-root-id)
        [ "$#" -ge 2 ] || { echo "--mm-root-id needs a value" >&2; exit 2; }
        mm_root_id="$2"; shift 2 ;;
      --mm-root-id=*)
        mm_root_id="${1#--mm-root-id=}"; shift ;;
      --mm-account)
        [ "$#" -ge 2 ] || { echo "--mm-account needs a value" >&2; exit 2; }
        mm_account="$2"; shift 2 ;;
      --mm-account=*)
        mm_account="${1#--mm-account=}"; shift ;;
      *)
        # Build positional list, one arg per line. With --body-file the BODY positional
        # is supplied out-of-band, so multi-line content no longer breaks this counter.
        positional="${positional}${1}${NL}"
        shift ;;
    esac
  done

  # Mattermost bridge — channel and root must come as a pair. Partial metadata
  # would break thread bridge silently (forge agent reads root_id; missing
  # channel would point to nowhere).
  if [ -n "$mm_channel" ] || [ -n "$mm_root_id" ]; then
    [ -n "$mm_channel" ] && [ -n "$mm_root_id" ] || {
      echo "ERROR: --mm-channel and --mm-root-id must be provided together" >&2
      exit 2
    }
    : "${mm_account:=forgebot}"
  fi

  pos_count=$(printf '%s' "$positional" | grep -c '^' || true)

  if [ -n "$body_file" ]; then
    # With --body-file the positional list is [REPO] TITLE (1 or 2 entries).
    if [ "$pos_count" -lt 1 ] || [ "$pos_count" -gt 2 ]; then
      echo "ERROR: issue-create --body-file needs TITLE (and optional REPO as first arg)" >&2
      exit 2
    fi
    if [ "$pos_count" -eq 2 ]; then
      repo_arg=$(printf '%s' "$positional" | sed -n '1p')
      title=$(printf '%s' "$positional" | sed -n '2p')
      case "$repo_arg" in
        */*) repo="$(repo_path "$repo_arg")" ;;
        *)   echo "ERROR: REPO arg must look like 'owner/repo' (got '$repo_arg'). To use default repo, pass only TITLE." >&2; exit 2 ;;
      esac
    else
      title=$(printf '%s' "$positional" | sed -n '1p')
      [ -n "$DEFAULT_REPO" ] || { echo "ERROR: no REPO arg and no default repo (profile=$FORGE_PROFILE has no FORGE_REPO). Pass owner/repo as first arg." >&2; exit 2; }
      repo="$(repo_path "$DEFAULT_REPO")"
    fi
    if [ "$body_file" = "-" ]; then
      body=$(cat)
    else
      [ -r "$body_file" ] || { echo "ERROR: --body-file not readable: $body_file" >&2; exit 2; }
      body=$(cat -- "$body_file")
    fi
  else
    # Inline BODY form — must be single-line (newline-in-arg breaks the positional counter).
    if [ "$pos_count" -lt 2 ] || [ "$pos_count" -gt 3 ]; then
      echo "ERROR: issue-create needs TITLE BODY (and optional REPO as first arg). For multi-line BODY use --body-file PATH (or - for stdin)." >&2
      exit 2
    fi
    if [ "$pos_count" -eq 3 ]; then
      repo_arg=$(printf '%s' "$positional" | sed -n '1p')
      title=$(printf '%s' "$positional" | sed -n '2p')
      body=$(printf '%s' "$positional" | sed -n '3p')
      case "$repo_arg" in
        */*) repo="$(repo_path "$repo_arg")" ;;
        *)   echo "ERROR: REPO arg must look like 'owner/repo' (got '$repo_arg'). To use default repo, pass only TITLE BODY." >&2; exit 2 ;;
      esac
    else
      title=$(printf '%s' "$positional" | sed -n '1p')
      body=$(printf '%s' "$positional" | sed -n '2p')
      [ -n "$DEFAULT_REPO" ] || { echo "ERROR: no REPO arg and no default repo (profile=$FORGE_PROFILE has no FORGE_REPO). Pass owner/repo as first arg." >&2; exit 2; }
      repo="$(repo_path "$DEFAULT_REPO")"
    fi
  fi

  [ -n "$title" ] || { echo "ERROR: empty title" >&2; exit 2; }
  [ -n "$body" ] || { echo "ERROR: empty body" >&2; exit 2; }

  log_context "$repo"

  # Resolve label names → ids (one API GET).
  label_ids_json="[]"
  if [ -n "$labels_csv" ]; then
    labels_json=$(api GET "/repos/$repo/labels")
    label_ids_json=$(printf '%s' "$labels_csv" | tr ',' '\n' | jq -R -s --argjson all "$labels_json" '
      split("\n") | map(select(length > 0)) as $names
      | $names | map(. as $n | ($all | map(select(.name == $n) | .id) | first))
      | if any(. == null) then
          ($names | map(select(. as $n | ($all | map(.name) | index($n)) == null))) as $missing
          | error("label(s) not found: " + ($missing | join(", ")))
        else .
        end
    ')
  fi

  # Body assembly order: body → (mm metadata, if any) → footer.
  # - footer stays last (bot-identification, human-visible, consistent with `comment`)
  # - mm metadata is an HTML comment (machine-readable, human-invisible in
  #   rendered markdown) sitting between body and footer.
  if [ -n "$mm_channel" ]; then
    mm_json=$(jq -n -c \
      --arg c "$mm_channel" \
      --arg r "$mm_root_id" \
      --arg a "$mm_account" \
      '{channel_id:$c, root_id:$r, account:$a}')
    mm_meta=$(printf '<!-- openclaw:mm %s -->' "$mm_json")
    full_body=$(printf '%s\n\n%s\n\n%s' "$body" "$mm_meta" "$FORGE_BOT_FOOTER")
  else
    full_body=$(printf '%s\n\n%s' "$body" "$FORGE_BOT_FOOTER")
  fi

  payload=$(jq -n \
    --arg t "$title" \
    --arg b "$full_body" \
    --argjson labels "$label_ids_json" \
    '{title:$t, body:$b, labels:$labels}')

  api_response=$(api POST "/repos/$repo/issues" "$payload")
  issue_num=$(printf '%s' "$api_response" | jq -r '.number')

  # Persist mm-link SSOT after issue is created (issue_num required for the key).
  # Optional — sqlite3 missing → warn and continue. body metadata is the
  # canonical surface; sqlite is a fast local lookup index.
  if [ -n "$mm_channel" ] && [ -n "$issue_num" ] && [ "$issue_num" != "null" ]; then
    mm_sqlite_save "$FORGE_PROFILE" "$repo" "$issue_num" "$mm_channel" "$mm_root_id" "$mm_account"
  fi

  printf '%s\n' "$api_response" | jq -r '"issue #\(.number) created at \(.html_url)\nlabels=[\([.labels[].name] | join(","))]"'
}

# Persist Mattermost thread bridge metadata to local SQLite SSOT.
# Schema: forge_mm_links(key TEXT PK, channel_id, root_id, account_id, created_at)
# key format: "<profile>:<owner/repo>#<issue_num>"  (e.g. "work:glg-bot/voscli#3")
# Idempotent via INSERT OR REPLACE — re-running issue-create against the same
# issue (rare, but possible during recovery) updates the row in place.
mm_sqlite_save() {
  _profile="$1"; _repo="$2"; _num="$3"
  _channel="$4"; _root="$5"; _account="$6"

  command -v sqlite3 >/dev/null 2>&1 || {
    echo "[forge] WARN: sqlite3 not installed, mm-link SSOT skipped (body metadata is canonical)" >&2
    return 0
  }

  _db_dir="$HOME/.openclaw/state"
  _db="$_db_dir/forge-mm-links.sqlite"
  mkdir -p "$_db_dir"

  _now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  _key="${_profile}:${_repo}#${_num}"

  # Single-quote escape — Mattermost IDs are alphanumeric in practice, but
  # treat all six values as untrusted at the SQL boundary.
  esc() { printf '%s' "$1" | sed "s/'/''/g"; }
  _k=$(esc "$_key"); _c=$(esc "$_channel"); _r=$(esc "$_root")
  _a=$(esc "$_account"); _t=$(esc "$_now")

  sqlite3 "$_db" <<SQL
CREATE TABLE IF NOT EXISTS forge_mm_links (
  key TEXT PRIMARY KEY,
  channel_id TEXT NOT NULL,
  root_id TEXT NOT NULL,
  account_id TEXT NOT NULL,
  created_at TEXT NOT NULL
);
INSERT OR REPLACE INTO forge_mm_links VALUES ('$_k','$_c','$_r','$_a','$_t');
SQL

  echo "[forge] mm-link saved: $_key → $_db" >&2
}

cmd_state() {
  [ "$#" -eq 1 ] || { usage >&2; exit 2; }
  issue="$1"
  repo="$(repo_path "$(issue_repo "$issue")")"
  num="$(issue_number "$issue")"
  issue_json=$(api GET "/repos/$repo/issues/$num")
  comments_json=$(api GET "/repos/$repo/issues/$num/comments")
  printf '%s\n' "$issue_json" | jq -r '"#\(.number) [\(.state)] \(.title)\nlabels=[\([.labels[].name] | join(","))]\ncomments=\(.comments)\nurl=\(.html_url)"'
  printf '%s\n' "$comments_json" | jq -r '
    if length == 0 then "recent_comments=(none)"
    else "recent_comments:" , (.[-3:][] | "- \(.user.login): \(.body | gsub("\\n"; " ") | .[0:160])")
    end'
}

cmd_auto_fix_template() {
  [ "$#" -eq 1 ] || { usage >&2; exit 2; }
  issue="$1"
  repo="$(repo_path "$(issue_repo "$issue")")"
  num="$(issue_number "$issue")"
  issue_json=$(api GET "/repos/$repo/issues/$num")
  printf '%s\n' "$issue_json" | jq -r \
    --arg profile "$FORGE_PROFILE" \
    --arg repo "$repo" '
    ([.labels[].name] | join(",")) as $labels
    | "<!-- forge:auto-fix profile=\"\($profile)\" issue=\"\($repo)#\(.number)\" updated_at=\"\(.updated_at)\" labels=\"\($labels)\" v=\"1\" -->\n\n" +
      "## Auto-fix lane result\n\n" +
      "### Eligibility\n" +
      "- Decision: eligible / not eligible\n" +
      "- Why bounded:\n" +
      "- Owner repo:\n" +
      "- Risk:\n\n" +
      "### 1회독 — direct fix pass\n" +
      "- Patch candidate:\n" +
      "- Direct smoke/test commands:\n" +
      "- Result:\n\n" +
      "### 2회독 — adjacent same-shape pass\n" +
      "- Search targets:\n" +
      "- Commands:\n" +
      "- Findings:\n" +
      "- Follow-up needed:\n\n" +
      "### 3회독 — independent review pass\n" +
      "- Reviewer/model/session:\n" +
      "- Concerns:\n" +
      "- Verdict:\n\n" +
      "### Final state meaning\n" +
      "Patch candidate + validation loop recorded. This does not mean auto-merged or human-release-approved."
  '
}

# Pre-parse profile override flag(s) before the command verb.
while [ "$#" -gt 0 ]; do
  case "${1:-}" in
    --forge)
      [ "$#" -ge 2 ] || { echo "--forge needs a value (oracle|work)" >&2; exit 2; }
      FORGE_PROFILE="$2"; shift 2 ;;
    --forge=*)
      FORGE_PROFILE="${1#--forge=}"; shift ;;
    *) break ;;
  esac
done

cmd="${1-}"
case "$cmd" in
  -h|--help|help|"") usage ;;
  repos)        require_env; shift; cmd_repos "$@" ;;
  list-open)    require_env; shift; cmd_list_open "$@" ;;
  state)        require_env; shift; cmd_state "$@" ;;
  auto-fix-template) require_env; shift; cmd_auto_fix_template "$@" ;;
  comment)      require_env; shift; cmd_comment "$@" ;;
  label-add)    require_env; shift; cmd_label_add "$@" ;;
  label-remove) require_env; shift; cmd_label_remove "$@" ;;
  label-set)    require_env; shift; cmd_label_set "$@" ;;
  issue-create) require_env; shift; cmd_issue_create "$@" ;;
  *) echo "unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac

#!/usr/bin/env sh
# git-credential-forge — git credential helper for Forgejo HTTPS push/pull.
#
# Bridges the SAME ~/.env.local profile token used by bin/forge's REST layer
# into git's native credential machinery. No token-in-URL, no askpass, no
# per-agent improvisation: `git push` against a forge remote just works on any
# machine (client laptops/desktops and the forge hosts themselves), even though
# the forge servers live on the oracle host and the work host.
#
# Generic / host-autodetecting: install as ONE global helper (no url scope),
# so no forge host literal lands in any committed file (the work host is an
# identity term). git calls it for every https credential request; this helper
# matches the request host (and path-prefix, when git provides it) against the
# forge profile URLs in ~/.env.local, emits the matching token, or stays silent
# so git falls through to its other helpers for non-forge hosts (github, etc.).
#
# Path-prefix safety: when a profile URL has a path (work = ".../forge") AND git
# provides the request path (credential.useHttpPath=true), the helper requires
# the path to be under that prefix, so a non-forge service sharing the same host
# never receives the forge token. Without useHttpPath the match degrades to
# host-only (still works; no path isolation).
#
# SSOT is ~/.env.local. The token is emitted at runtime only — never written
# to disk (no ~/.git-credentials duplication).
#
# Install (machine-local ~/.gitconfig, NOT nixos-config — decided 2026-06-02):
#
#   git config --global credential.helper ~/repos/gh/forge-config/bin/git-credential-forge
#   # optional, engages path isolation on a shared host like work's:
#   git config --global credential.useHttpPath true
#
# git invokes:  git-credential-forge <get|store|erase>   (on stdin: key=val lines)
# Protocol: https://git-scm.com/docs/gitcredentials

set -eu

op="${1:-}"

# store / erase: token lives in ~/.env.local, nothing to persist or wipe.
[ "$op" = "get" ] || exit 0

# Pull forge profile vars from ~/.env.local (git inherits its own environment,
# not an interactive shell's, so they may not be exported).
if [ -f "$HOME/.env.local" ]; then
  # shellcheck disable=SC1090
  . "$HOME/.env.local" 2>/dev/null || true
fi

# Read the request git wrote on stdin: key=value lines, blank line terminates.
req_host=""
req_proto=""
req_path=""
while IFS= read -r line; do
  [ -z "$line" ] && break
  case "$line" in
    host=*)     req_host="${line#host=}" ;;
    protocol=*) req_proto="${line#protocol=}" ;;
    path=*)     req_path="${line#path=}" ;;
    *) : ;;
  esac
done

# Only forge over https. Anything else → decline (git falls through).
[ "$req_proto" = "https" ] || exit 0
[ -n "$req_host" ] || exit 0

# host[:port] of a forge URL (strip scheme + path).
url_host() { h="${1#*://}"; printf '%s' "${h%%/*}"; }
# path of a forge URL with leading/trailing slashes trimmed ("" if none).
url_path() {
  p="${1#*://}"
  case "$p" in */*) p="${p#*/}" ;; *) p="" ;; esac
  p="${p#/}"; p="${p%/}"
  printf '%s' "$p"
}

emit() { printf 'username=%s\npassword=%s\n' "$1" "$2"; }

# Does the request match this profile's host (+ path-prefix when both present)?
host_path_match() {
  # $1 = profile URL
  purl="$1"
  [ -n "$purl" ] || return 1
  [ "$req_host" = "$(url_host "$purl")" ] || return 1
  ppath="$(url_path "$purl")"
  # Engage path isolation only when the profile has a prefix AND git gave a path.
  if [ -n "$ppath" ] && [ -n "$req_path" ]; then
    rp="${req_path#/}"
    case "$rp" in
      "$ppath"|"$ppath"/*) return 0 ;;
      *) return 1 ;;
    esac
  fi
  return 0
}

# Match against each known forge profile. First match wins.
if host_path_match "${ORACLE_FORGE_URL:-}"; then
  [ -n "${ORACLE_FORGE_TOKEN:-}" ] && emit "${ORACLE_FORGE_USER:-glg-bot}" "$ORACLE_FORGE_TOKEN"
  exit 0
fi
if host_path_match "${WORK_FORGE_URL:-}"; then
  [ -n "${WORK_FORGE_TOKEN:-}" ] && emit "${WORK_FORGE_USER:-glg-bot}" "$WORK_FORGE_TOKEN"
  exit 0
fi

# Not a forge host → silent decline. git uses its next helper / askpass.
exit 0
